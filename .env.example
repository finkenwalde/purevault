# Copy this file to .env.https for the optional HTTPS Compose configuration.
# Set the hostname your reverse proxy forwards to Purevault.
PUREVAULT_ALLOWED_HOSTS=vault.example.com #optional
PUREVAULT_SECURE_COOKIES=true #optional
PUREVAULT_TRUST_PROXY_HEADERS=true #optional
# Optional app-level redirect if the proxy does not already redirect HTTP.
# PUREVAULT_SECURE_SSL_REDIRECT=true #optional
# Add an HTTPS origin only if a legitimate form submission uses a different origin.
# PUREVAULT_CSRF_TRUSTED_ORIGINS=https://vault.example.com #optional
# Enable HSTS only after confirming HTTPS works.
# PUREVAULT_HSTS_SECONDS=31536000 #optional
