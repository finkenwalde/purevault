# Optional IANA timezone used only for readable deadline display.
PUREVAULT_DISPLAY_TIMEZONE=UTC
PUREVAULT_BIND_ADDRESS=127.0.0.1
PUREVAULT_PORT=8127
PUREVAULT_ALLOWED_HOSTS=localhost,127.0.0.1

# Production HTTPS examples (configure a trusted reverse proxy as well):
# PUREVAULT_SECURE_COOKIES=true
# PUREVAULT_SECURE_SSL_REDIRECT=true
# PUREVAULT_HSTS_SECONDS=31536000
# PUREVAULT_CSRF_TRUSTED_ORIGINS=https://vault.example.com
# PUREVAULT_TRUST_PROXY_HEADERS=true

